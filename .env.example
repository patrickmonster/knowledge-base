# Local development only. Use a URL-safe random value (for example, 32 hex characters).
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
DATABASE_URL=postgres://knowledge:replace-with-a-random-url-safe-password@localhost:55432/knowledge?sslmode=disable
PUBLIC_URL=http://localhost:8080
APP_ENV=local
PORT=8080
TRUST_PROXY=false
# Local Ollama; compose uses its private ollama service instead of this host URL.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_ENABLED=true
# Supply these only for the one-time bootstrap command; remove them afterwards.
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_NAME=Administrator
BOOTSTRAP_PASSWORD=
