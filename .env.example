# Local development only. Use a URL-safe random value (for example, 32 hex characters).
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
DATABASE_URL=postgres://knowledge:replace-with-a-random-url-safe-password@localhost:55432/knowledge?sslmode=disable
PUBLIC_URL=http://localhost:8080
APP_ENV=local
PORT=8080
TRUST_PROXY=false
# Local Ollama; compose uses its private ollama service instead of this host URL.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
# CPU threads per embedding request (0 = Ollama decides; it may use every visible host core).
EMBEDDING_NUM_THREADS=4
EMBEDDING_ENABLED=true
# First-run setup in the web console (shown while no administrator exists).
# At least 20 random characters; empty logs a random setup_code at startup instead.
SETUP_TOKEN=
# Supply these only for the one-time bootstrap command; remove them afterwards.
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_NAME=Administrator
BOOTSTRAP_PASSWORD=

# Optional Railway bucket. Set all five values together; no AWS account is needed.
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_REGION=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
# New Railway buckets use virtual-hosted URLs. Legacy buckets may require true.
BUCKET_FORCE_PATH_STYLE=false
# Attachment policy: per-project quota in MiB (0 = unlimited), optional clamd host:port.
# Local: CLAMAV_ADDRESS=clamav:3310 with `docker compose --profile clamav up`.
ATTACHMENT_PROJECT_QUOTA_MB=1024
CLAMAV_ADDRESS=
ATTACHMENT_ALLOW_EXECUTABLES=false
# Extract text from uploaded .pdf/.docx/.xlsx into searchable artifact documents.
ATTACHMENT_TEXT_EXTRACTION=true
# Two-step sign-in (TOTP). At least 32 random characters, e.g. `openssl rand -base64 48`.
# Empty disables MFA setup; changing or losing it breaks enrolled users' MFA (admin must reset).
MFA_ENCRYPTION_KEY=
# Retention: 0 keeps forever. Audit 90-3650 days, revisions 30-3650 days.
AUDIT_RETENTION_DAYS=0
REVISION_RETENTION_DAYS=0
REVISION_KEEP_LATEST=20
# HNSW review thresholds for get_usage_stats hnsw_review (projects may override).
# Vector search p95 in ms (1-60000) and chunks one scan compares (100-100000000).
HNSW_REVIEW_VECTOR_P95_MS=100
HNSW_REVIEW_SCANNED_CHUNKS=20000

# GitHub (optional). Without a token only public repositories work (60 requests/hour).
# Used by import_github_issues and by pull request merge/deployment tracking.
GITHUB_TOKEN=
# GitHub Enterprise Server only, e.g. https://ghe.example.com/api/v3
GITHUB_API_URL=
# owner/name this server is built from; on Railway it defaults to RAILWAY_GIT_REPO_OWNER/NAME.
# Pull requests in this repository are marked deployed once the running build contains them.
SERVER_REPOSITORY=
# Background check of pull requests named in finish_task (true by default).
DEPLOYMENT_CHECKS=true

# Issue notifications (webhook / Slack / email channels are configured per project in the web console).
# Set NOTIFICATIONS_ENABLED=false to queue notifications without delivering them.
NOTIFICATIONS_ENABLED=true
# Optional SMTP for email channels. Without SMTP_HOST, email notifications fail with SMTP_NOT_CONFIGURED.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
